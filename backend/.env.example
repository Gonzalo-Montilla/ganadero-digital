# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ganadero_digital
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/ganadero_digital_test

# JWT Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
APP_NAME=Ganadero Digital
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# Redis (para rate limiting y cache)
REDIS_URL=redis://localhost:6379/0

# Email (alertas diarias)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=fincaelprogreso208@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=fincaelprogreso208@gmail.com
SMTP_FROM_NAME=Finca El Progreso
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_DAILY_HOUR=6
NOTIFICATIONS_DAILY_MINUTE=0

# Logo embebido en correos (generar con: python scripts/generate_email_logo.py)
EMAIL_LOGO_PATH=media/branding/logo-email.png
EMAIL_LOGO_CID=logo_finca

# Configuración de archivos
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# Configuración colombiana
TIMEZONE=America/Bogota
LOCALE=es_CO

# CORS (orígenes del frontend, separados por coma — sin JSON)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Registro público (false = solo bootstrap del primer usuario vía API)
ALLOW_PUBLIC_REGISTRATION=false
